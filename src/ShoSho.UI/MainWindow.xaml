<Window x:Class="ShoSho.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:ShoSho.UI.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:MainViewModel, IsDesignTimeCreatable=True}"
        Title="Шо-Шо | Каталог вражень" Height="760" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5EFE6"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E0D6C8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#322824" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="243*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#2B231F" Padding="24,32,24,24" Grid.RowSpan="2">
            <StackPanel>
                <TextBlock Text="Шо-Шо" FontSize="32" FontFamily="Georgia" Foreground="#F5EFE6" Margin="0,0,0,2" />
                <TextBlock Text="ОСОБИСТИЙ МЕДІААРХІВ" FontSize="10" FontWeight="SemiBold" Foreground="#8C7A70" Margin="0,0,0,40" />
                <TextBlock Text="КОЛЕКЦІЯ" FontSize="11" Foreground="#8C7A70" FontWeight="Bold" Margin="0,0,0,16" />

                <Border Background="#3A302A" CornerRadius="6" Padding="12,10" Margin="-12,0,-12,8">
                    <Grid>
                        <TextBlock Text="Усі враження" FontSize="15" FontWeight="SemiBold" Foreground="#F5EFE6" />
                        <TextBlock Text="{Binding Items.Count}" FontSize="13" Foreground="#8C7A70" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <TextBlock Text="Фільми" FontSize="15" Foreground="#A99B92" Margin="0,10" />
                <TextBlock Text="Серіали" FontSize="15" Foreground="#A99B92" Margin="0,10" />
                <TextBlock Text="Книги" FontSize="15" Foreground="#A99B92" Margin="0,10" />
                <TextBlock Text="Ігри" FontSize="15" Foreground="#A99B92" Margin="0,10" />
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="40,17,40,20" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="МОЯ КОЛЕКЦІЯ - 2026" FontSize="11" Foreground="#A68A77" FontWeight="Bold" Margin="0,0,0,8" />
                    <TextBlock Text="Каталог вражень" FontSize="38" FontFamily="Georgia" Foreground="#2B231F" />
                    <TextBlock Text="Фільми, книжки й світи, до яких хочеться повернутися." FontSize="15" Foreground="#7C6D65" Margin="0,8,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                    <StackPanel Margin="0,0,0,0">
                        <TextBlock Text="СТАТУС" FontSize="11" FontWeight="Bold" Foreground="#A68A77" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding AvailableStatuses}"
                                  SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}"
                                  Background="#FDFBFC" BorderBrush="#EADECF" BorderThickness="1"
                                  Foreground="#322824" FontSize="14" Padding="12,8" Width="140" Cursor="Hand">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <Setter Property="IsEditable" Value="True"/>
                                    <Setter Property="Text" Value="Усі статуси"/>
                                    <Setter Property="IsReadOnly" Value="True"/>
                                </Style>
                            </ComboBox.Style>
                            <ComboBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8" />
                                </Style>
                            </ComboBox.Resources>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#FDFBFC" CornerRadius="12" Padding="20" BorderBrush="#EADECF" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding NewItemTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,12" ToolTip="Введіть назву фільму, серіалу або гри" />
                        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding NewItemTags, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0" ToolTip="Введіть теги через кому (наприклад: драйв, затишне, навчання)" />

                        <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Command="{Binding AddItemCommand}" Content="+ Додати" FontSize="15" FontWeight="SemiBold" Foreground="White" Background="#C27A63" BorderThickness="0" Padding="28,0" Cursor="Hand" IsDefault="True">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8" />
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Background="#FDFBFC" CornerRadius="12" Padding="20" BorderBrush="#EADECF" BorderThickness="1">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ФІЛЬТР ЗА ТЕГОМ" FontSize="11" FontWeight="Bold" Foreground="#A68A77" Margin="0,0,0,10" />
                        <TextBox Text="{Binding SearchTagFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Шукати за тегом (наприклад: драйв)" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2">
                <TextBlock Text="Поки що немає збережених записів. Додайте свій перший фільм чи гру вище!" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#A68A77" FontSize="15" FontStyle="Italic">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ListBox ItemsSource="{Binding Items}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,12" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FDFBFC" BorderBrush="#EADECF" BorderThickness="1" CornerRadius="12" Padding="24,20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="18" FontFamily="Georgia" FontWeight="SemiBold" Foreground="#2B231F" />
                                        <TextBlock Text="{Binding CreatedAt, StringFormat='Додано: \{0:dd.MM.yyyy\}'}" FontSize="12" Foreground="#A68A77" Margin="0,4,0,12" />

                                        <ItemsControl ItemsSource="{Binding Tags}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#EFE8DD" CornerRadius="12" Margin="0,0,8,6" Padding="12,4">
                                                        <TextBlock Text="{Binding Name}" Foreground="#5D4F46" FontSize="12" FontWeight="SemiBold" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding DataContext.AvailableStatuses, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding Status, Mode=TwoWay}"
                                              SelectionChanged="StatusComboBox_SelectionChanged"
                                              Background="#E6DFD3"
                                              BorderThickness="0"
                                              Foreground="#5D4F46"
                                              FontWeight="Bold"
                                              FontSize="12"
                                              VerticalAlignment="Top"
                                              Margin="0,4,0,0"
                                              Padding="12,6"
                                              Width="115"
                                              Cursor="Hand">
                                        <ComboBox.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="12" />
                                            </Style>
                                        </ComboBox.Resources>
                                    </ComboBox>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <StatusBar Grid.Row="3" Background="Transparent" Margin="0,16,0,0" Padding="0">
                <StatusBarItem Padding="0">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="#7C6D65" />
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </Grid>
</Window>