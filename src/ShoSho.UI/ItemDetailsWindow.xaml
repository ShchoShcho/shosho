<Window x:Class="ShoSho.UI.ItemDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Деталі запису" Width="820" Height="760" MinWidth="650" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="#F5EFE6" Foreground="#322824" FontFamily="Segoe UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,4,0,14"/>
            <Setter Property="Background" Value="#FDFBFC"/><Setter Property="BorderBrush" Value="#E0D6C8"/>
        </Style>
        <Style TargetType="ComboBox"><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,4,0,14"/></Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8C7A70"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,16,0,5"/>
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="15"/>
        </Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,24,0">
                    <Image Height="280" Stretch="UniformToFill"
                           Source="{Binding CoverSource, TargetNullValue='pack://application:,,,/ShoSho.UI;component/Assets/placeholder.jpg', FallbackValue='pack://application:,,,/ShoSho.UI;component/Assets/placeholder.jpg'}"/>
                    <TextBlock Text="ОБКЛАДИНКА" Style="{StaticResource Label}"/>
                    <TextBlock Text="{Binding PosterUrl}" TextWrapping="Wrap" Foreground="#8C7A70" FontSize="11"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <StackPanel x:Name="ReadPanel">
                        <StackPanel.Style><Style TargetType="StackPanel">
                            <Style.Triggers><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                        </Style></StackPanel.Style>
                        <TextBlock Text="{Binding Title}" FontFamily="Georgia" FontSize="28" TextWrapping="Wrap"/>
                        <TextBlock Text="ТИП МЕДІА" Style="{StaticResource Label}"/>
                        <TextBlock Text="{Binding MediaType}" Style="{StaticResource Value}"/>
                        <TextBlock Text="СТАТУС" Style="{StaticResource Label}"/>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Value}"/>
                        <TextBlock Text="ОПИС / НОТАТКА" Style="{StaticResource Label}"/>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Value}"/>
                        <TextBlock Text="ТЕГИ НАСТРОЮ" Style="{StaticResource Label}"/>
                        <TextBlock Text="{Binding Tags}" Style="{StaticResource Value}"/>
                        <TextBlock Text="ОЦІНКА" Style="{StaticResource Label}"/>
                        <TextBlock Text="{Binding Rating, TargetNullValue='Не вказано', StringFormat={}{0} / 5}" Style="{StaticResource Value}"/>
                        <TextBlock Text="ВІДГУК" Style="{StaticResource Label}"/>
                        <TextBlock Text="{Binding ReviewText}" Style="{StaticResource Value}"/>
                    </StackPanel>
                    <StackPanel x:Name="EditPanel" Visibility="{Binding IsEditing, Converter={StaticResource BoolVisibility}}">
                        <StackPanel.Style><Style TargetType="StackPanel">
                            <Style.Triggers><DataTrigger Binding="{Binding IsSaving}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers>
                        </Style></StackPanel.Style>
                        <TextBlock Text="Редагування" FontFamily="Georgia" FontSize="26" Margin="0,0,0,20"/>
                        <TextBlock Text="Назва"/>
                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" MaxLength="255"/>
                        <TextBlock Text="Тип медіа"/>
                        <ComboBox ItemsSource="{Binding MediaTypes}" SelectedItem="{Binding MediaType}"/>
                        <TextBlock Text="Статус"/>
                        <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status}"/>
                        <TextBlock Text="Посилання або шлях до обкладинки"/>
                        <TextBox Text="{Binding PosterUrl, UpdateSourceTrigger=PropertyChanged}" MaxLength="1000"/>
                        <TextBlock Text="Опис / нотатка"/>
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000" MinHeight="80" TextWrapping="Wrap" AcceptsReturn="True"/>
                        <TextBlock Text="Теги настрою (через кому або #)"/>
                        <TextBox Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Оцінка (необов'язково)"/>
                        <ComboBox ItemsSource="{Binding Ratings}" SelectedItem="{Binding Rating}" IsEnabled="{Binding CanEditReview}"/>
                        <TextBlock Text="Відгук"/>
                        <TextBox Text="{Binding ReviewText, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000" MinHeight="100" TextWrapping="Wrap" AcceptsReturn="True" IsEnabled="{Binding CanEditReview}"/>
                        <TextBlock Text="Оцінку й відгук можна змінювати для статусу «Вже всьо». Попередні враження зберігаються при зміні статусу."
                                   TextWrapping="Wrap" Foreground="#8C7A70" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#A33D32" TextWrapping="Wrap" VerticalAlignment="Center"/>

            <Button Content="Видалити" Command="{Binding DeleteCommand}" Padding="22,10"
                    Background="#A33D32" Foreground="White" HorizontalAlignment="Left"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <StackPanel.Style><Style TargetType="StackPanel">
                    <Style.Triggers><DataTrigger Binding="{Binding IsSaving}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers>
                </Style></StackPanel.Style>
                <Button Content="Закрити" Click="CloseClicked" Padding="22,10" Margin="0,0,10,0"/>
                <Button Content="Редагувати" Command="{Binding EditCommand}" Padding="22,10">
                    <Button.Style><Style TargetType="Button">
                        <Style.Triggers><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                    </Style></Button.Style>
                </Button>
                <Button Content="Зберегти" Command="{Binding SaveCommand}" Padding="22,10" Background="#C27A63" Foreground="White"
                        Visibility="{Binding IsEditing, Converter={StaticResource BoolVisibility}}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
