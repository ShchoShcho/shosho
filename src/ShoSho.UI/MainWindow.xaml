<Window x:Class="ShoSho.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:ShoSho.UI.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:MainViewModel, IsDesignTimeCreatable=True}"
        Title="ШоШо" Height="650" Width="800"
        MinHeight="450" MinWidth="550"
        WindowStartupLocation="CenterScreen"
        Background="#F5EFE6"
        FontFamily="Segoe UI">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Input Bar -->
            <RowDefinition Height="Auto" />
            <!-- Content List -->
            <RowDefinition Height="*" />
            <!-- Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="ШоШо"
                       FontSize="36"
                       FontWeight="Bold"
                       FontFamily="Georgia"
                       Foreground="#2C221E" />
            <TextBlock Text="Особистий трекер фільмів, серіалів, аніме та ігор"
                       FontSize="13"
                       Foreground="#78685E"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- Input Bar (Walking Skeleton form) -->
        <Border Grid.Row="1"
                Background="#FAF6F0"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,20"
                BorderBrush="#E3DCD2"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.05" Color="Black" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="ItemTitleTextBox"
                         Grid.Column="0"
                         Text="{Binding NewItemTitle, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="15"
                         VerticalContentAlignment="Center"
                         Padding="12,10"
                         BorderThickness="1"
                         BorderBrush="#D4C9BC"
                         Background="White"
                         Foreground="#2C221E"
                         Margin="0,0,10,0"
                         ToolTip="Введіть назву фільму, серіалу або гри" />

                <Button Grid.Column="1"
                        Command="{Binding AddItemCommand}"
                        Content="Додати"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="#FAF6F0"
                        Background="#3D3028"
                        BorderThickness="0"
                        Padding="24,10"
                        Cursor="Hand"
                        IsDefault="True">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- Media Items List -->
        <Border Grid.Row="2"
                Background="#FAF6F0"
                CornerRadius="8"
                Padding="16"
                BorderBrush="#E3DCD2"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.05" Color="Black" />
            </Border.Effect>
            <Grid>
                <!-- Empty state placeholder -->
                <TextBlock Text="Поки що немає збережених записів. Додайте свій перший фільм чи гру вище!"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#A3968C"
                           FontSize="14"
                           FontStyle="Italic">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- List view -->
                <ListBox ItemsSource="{Binding Items}"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,10" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White"
                                    BorderBrush="#E8E2D8"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="#2C221E" />
                                        <TextBlock Text="{Binding CreatedAt, StringFormat='Створено: {0:dd.MM.yyyy HH:mm}'}"
                                                   FontSize="12"
                                                   Foreground="#A3968C"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>

                                    <!-- Status Badge -->
                                    <Border Grid.Column="1"
                                            Background="#EFECE6"
                                            BorderBrush="#D4CBC0"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="12,5"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Status}"
                                                   FontSize="12"
                                                   FontWeight="Medium"
                                                   Foreground="#594A42" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3"
                   Background="Transparent"
                   Margin="0,12,0,0"
                   Padding="0">
            <StatusBarItem Padding="0">
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="#78685E" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>

