<Window x:Class="ShoSho.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:ShoSho.UI.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:MainViewModel, IsDesignTimeCreatable=True}"
        Title="Шо-Шо | Каталог вражень"
        Height="760"
        Width="1100"
        MinHeight="600"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5EFE6"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background"
                    Value="White"/>
            <Setter Property="BorderBrush"
                    Value="#E0D6C8"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Foreground"
                    Value="#322824"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Padding"
                    Value="14,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="0"
                                          Padding="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderComboBoxStyle"
               TargetType="ComboBox">
            <Setter Property="Background"
                    Value="#F8F4ED"/>
            <Setter Property="Foreground"
                    Value="#322824"/>
            <Setter Property="FontSize"
                    Value="13"/>
            <Setter Property="Padding"
                    Value="12,8,24,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="#EADECF"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <ToggleButton x:Name="ToggleButton"
                                              BorderThickness="0"
                                              Background="Transparent"
                                              IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              ClickMode="Press">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent"
                                                    CornerRadius="8">
                                                <Path x:Name="Arrow"
                                                      Fill="#7C6D65"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,10,0"
                                                      Data="M0,0 L4,4 L8,0 Z"/>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="ContentSite"
                                                  IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"/>
                                <Popup x:Name="Popup"
                                       Placement="Bottom"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Slide">
                                    <Border Background="White"
                                            BorderBrush="#EADECF"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Margin="0,4,0,0">
                                        <ScrollViewer Margin="4"
                                                      SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True"
                                                        KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillComboBoxStyle"
               TargetType="ComboBox">
            <Setter Property="Background"
                    Value="#EFE8DD"/>
            <Setter Property="Foreground"
                    Value="#7C6D65"/>
            <Setter Property="FontSize"
                    Value="12"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Padding"
                    Value="12,6,24,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="14">
                            <Grid>
                                <ToggleButton x:Name="ToggleButton"
                                              BorderThickness="0"
                                              Background="Transparent"
                                              IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              ClickMode="Press">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent"
                                                    CornerRadius="14">
                                                <Path x:Name="Arrow"
                                                      Fill="#7C6D65"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,10,0"
                                                      Data="M0,0 L3,3 L6,0 Z"/>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="ContentSite"
                                                  IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"/>
                                <Popup x:Name="Popup"
                                       Placement="Bottom"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Slide">
                                    <Border Background="White"
                                            BorderBrush="#EADECF"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Margin="0,4,0,0">
                                        <ScrollViewer Margin="4"
                                                      SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True"
                                                        KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">
            <Setter Property="Background"
                    Value="#D48666"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="20"
                                Padding="24,12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter Property="Background"
                                        Value="#EADECF"/>
                                <Setter Property="Foreground"
                                        Value="#A68A77"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter Property="Background"
                                        Value="#C27A63"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CategoryButtonStyle"
               TargetType="Button">
            <Setter Property="Foreground"
                    Value="#A99B92"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="12,10"
                                Margin="0,0,0,4">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}"
                                               FontSize="14"
                                               Margin="0,0,12,0"
                                               Foreground="{TemplateBinding Foreground}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="14"
                                               Foreground="{TemplateBinding Foreground}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Count}"
                                           FontSize="12"
                                           Foreground="#8C7A70"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#342A25"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}"
                                         Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#3A302A"/>
                                <Setter Property="Foreground"
                                        Value="#F5EFE6"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#2B231F"
                Padding="24,32,24,24">
            <StackPanel>
                <TextBlock Text="Шо-Шо"
                           FontSize="32"
                           FontFamily="Georgia"
                           Foreground="#F5EFE6"
                           Margin="0,0,0,2"/>
                <TextBlock Text="ОСОБИСТИЙ МЕДІААРХІВ"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="#8C7A70"
                           Margin="0,0,0,40"/>

                <TextBlock Text="КОЛЕКЦІЯ"
                           FontSize="11"
                           Foreground="#8C7A70"
                           FontWeight="Bold"
                           Margin="0,0,0,16"/>

                <ItemsControl ItemsSource="{Binding Categories}"
                              Margin="0,0,0,24">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource CategoryButtonStyle}"
                                    Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                    ContextMenuService.IsEnabled="{Binding IsCustom}">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Видалити категорію"
                                                  Command="{Binding PlacementTarget.Tag.DeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="+ Створити категорію"
                        Command="{Binding CreateCategoryCommand}"
                        FontSize="13"
                        Foreground="#E0D6C8"
                        Background="Transparent"
                        BorderBrush="#8C7A70"
                        BorderThickness="1"
                        Padding="12,10"
                        Cursor="Hand"
                        HorizontalContentAlignment="Left">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius"
                                    Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1"
              Margin="48,40,48,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- 0: Заголовок -->
                <RowDefinition Height="Auto"/>
                <!-- 1: Вкладки фільтрів -->
                <RowDefinition Height="Auto"/>
                <!-- 2: Поле вводу -->
                <RowDefinition Height="*"/>
                <!-- 3: Сітка карток -->
                <RowDefinition Height="Auto"/>
                <!-- 4: Статус-бар -->
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="0,0,0,32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">
                    <TextBlock Text="МОЯ КОЛЕКЦІЯ - 2026"
                               FontSize="11"
                               Foreground="#A68A77"
                               FontWeight="Bold"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="Каталог вражень"
                               FontSize="36"
                               FontFamily="Georgia"
                               Foreground="#2B231F"/>
                    <TextBlock Text="Фільми, книжки й світи, до яких хочеться повернутися."
                               FontSize="14"
                               Foreground="#7C6D65"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="СТАТУС"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#A68A77"
                                   Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding StatusFilters}"
                                  SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}"
                                  Style="{StaticResource HeaderComboBoxStyle}"
                                  Width="140"
                                  Cursor="Hand"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="РЕЙТИНГ"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#A68A77"
                                   Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding RatingSortOptions}"
                                  SelectedItem="{Binding SelectedRatingSort}"
                                  Style="{StaticResource HeaderComboBoxStyle}"
                                  Width="140"
                                  Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1"
                  Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Пошук за назвою"/>
                    <TextBlock Text="Пошук за назвою…"
                               Foreground="#A99B92"
                               FontSize="14"
                               Margin="15,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility"
                                        Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}"
                                                 Value="">
                                        <Setter Property="Visibility"
                                                Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <ToggleButton x:Name="TagToggle"
                              Grid.Column="1"
                              Content="{Binding TagButtonText}"
                              Margin="12,0,0,0"
                              Padding="18,0"
                              Cursor="Hand"
                              FontSize="14"
                              Foreground="#322824">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="White"
                                    BorderBrush="#E0D6C8"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <Popup PlacementTarget="{Binding ElementName=TagToggle}"
                       Placement="Bottom"
                       IsOpen="{Binding IsChecked, ElementName=TagToggle, Mode=TwoWay}"
                       StaysOpen="True"
                       AllowsTransparency="True">
                    <Border Background="White"
                            BorderBrush="#EADECF"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="0,4,0,0"
                            Padding="12"
                            MinWidth="220"
                            MaxHeight="320">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,10,0,0">
                                <Button Content="Скинути"
                                        Command="{Binding ClearTagsCommand}"
                                        Padding="12,4"
                                        Margin="0,0,8,0"/>
                                <Button Content="Готово"
                                        Padding="12,4"
                                        Click="CloseTagPopup_Click"/>
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding AvailableTags}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Margin="0,3"
                                                      FontSize="13"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Popup>
            </Grid>

            <ListBox Grid.Row="3"
                     ItemsSource="{Binding Items}"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding"
                                Value="0"/>
                        <Setter Property="Margin"
                                Value="0,0,16,16"/>
                        <Setter Property="HorizontalContentAlignment"
                                Value="Stretch"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Button Width="260"
                                Command="{Binding DataContext.OpenItemDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Cursor="Hand"
                                ToolTip="Відкрити деталі"
                                AutomationProperties.Name="{Binding Title}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CardBorder"
                                            Background="#FAF6F0"
                                            CornerRadius="8"
                                            BorderBrush="#D4C9BC"
                                            BorderThickness="1"
                                            ClipToBounds="True">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter TargetName="CardBorder"
                                                    Property="BorderBrush"
                                                    Value="#C27A63"/>
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused"
                                                 Value="True">
                                            <Setter TargetName="CardBorder"
                                                    Property="BorderBrush"
                                                    Value="#C27A63"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel>
                                <Image Height="220"
                                       Stretch="UniformToFill"
                                       Source="{Binding PosterUrl, IsAsync=True, TargetNullValue='pack://application:,,,/ShoSho.UI;component/Assets/placeholder.jpg', FallbackValue='pack://application:,,,/ShoSho.UI;component/Assets/placeholder.jpg'}"/>
                                <StackPanel Margin="12">
                                    <TextBlock Text="{Binding Title}"
                                               FontFamily="Georgia"
                                               FontSize="18"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Type}"
                                               Foreground="#8C7A70"
                                               Margin="0,4,0,10"/>
                                    <TextBlock Foreground="#A47732"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,10">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text"
                                                        Value="{Binding Review.Rating, StringFormat='★ {0} / 5', TargetNullValue='Без оцінки', FallbackValue='Без оцінки'}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Review.Rating}" Value="{x:Null}">
                                                        <Setter Property="Text"
                                                                Value="{Binding Rating, StringFormat='★ {0} / 5', TargetNullValue='Без оцінки'}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Review}" Value="{x:Null}">
                                                        <Setter Property="Text"
                                                                Value="{Binding Rating, StringFormat='★ {0} / 5', TargetNullValue='Без оцінки'}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Border Background="#EFE8DD"
                                            CornerRadius="12"
                                            Padding="10,5"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Status}"
                                                   Foreground="#7C6D65"
                                                   FontSize="12"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="4"
                  Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding VisibleCount, StringFormat='Показано {0} записів'}"
                               FontSize="13"
                               Foreground="#8C7A70"/>
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="11"
                               Foreground="#C27A63"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <Button Command="{Binding AddItemCommand}"
                            Content="+ Додати бажанку"
                            Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
