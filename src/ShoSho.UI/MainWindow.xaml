<Window x:Class="ShoSho.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:ShoSho.UI.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:MainViewModel, IsDesignTimeCreatable=True}"
        Title="Шо-Шо | Каталог вражень" Height="760" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5EFE6"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E0D6C8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#322824" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="243*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#2B231F" Padding="24,32,24,24" Grid.RowSpan="2">
            <StackPanel>
                <TextBlock Text="Шо-Шо" FontSize="32" FontFamily="Georgia" Foreground="#F5EFE6" Margin="0,0,0,2" />
                <TextBlock Text="ОСОБИСТИЙ МЕДІААРХІВ" FontSize="10" FontWeight="SemiBold" Foreground="#8C7A70" Margin="0,0,0,40" />
                <TextBlock Text="КОЛЕКЦІЯ" FontSize="11" Foreground="#8C7A70" FontWeight="Bold" Margin="0,0,0,16" />

                <Border Background="#3A302A" CornerRadius="6" Padding="12,10" Margin="-12,0,-12,8">
                    <Grid>
                        <TextBlock Text="Усі враження" FontSize="15" FontWeight="SemiBold" Foreground="#F5EFE6" />
                        <TextBlock Text="{Binding Items.Count}" FontSize="13" Foreground="#8C7A70" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <TextBlock Text="Фільми" FontSize="15" Foreground="#A99B92" Margin="0,10" />
                <TextBlock Text="Серіали" FontSize="15" Foreground="#A99B92" Margin="0,10" />
                <TextBlock Text="Книги" FontSize="15" Foreground="#A99B92" Margin="0,10" />
                <TextBlock Text="Ігри" FontSize="15" Foreground="#A99B92" Margin="0,10" />
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="40,17,40,20" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- 0: Заголовок -->
                <RowDefinition Height="Auto" />
                <!-- 1: Вкладки фільтрів -->
                <RowDefinition Height="Auto" />
                <!-- 2: Поле вводу -->
                <RowDefinition Height="*" />
                <!-- 3: Сітка карток -->
                <RowDefinition Height="Auto" />
                <!-- 4: Статус-бар -->
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <StackPanel Grid.Row="0" Margin="0,0,0,25">
                <TextBlock Text="МОЯ КОЛЕКЦІЯ - 2026" FontSize="11" Foreground="#B89F89" FontWeight="SemiBold" Margin="0,0,0,5" />
                <TextBlock Text="Каталог вражень" FontSize="32" FontFamily="Georgia" Foreground="#2C221E" />
                <TextBlock Text="Фільми, книжки й світи, до яких хочеться повернутися." FontSize="14" Foreground="#78685E" Margin="0,6,0,0" />
            </StackPanel>

            <!-- Вкладки фільтрації статусів (НОВИЙ БЛОК) -->
            <!-- Вкладки фільтрації статусів -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
                <StackPanel.Resources>
                    <!-- Цей стиль перетворює стандартний RadioButton на твій красивий текст -->
                    <Style TargetType="RadioButton" x:Key="FilterTabStyle">
                        <Setter Property="GroupName" Value="StatusFilters" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Margin" Value="0,0,24,0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="RadioButton">
                                    <TextBlock x:Name="TabText" 
                                               Text="{TemplateBinding Content}" 
                                               FontSize="14" 
                                               Foreground="#78685E" />
                                    <!-- Якщо вкладка активна, робимо її помаранчевою і напівжирною -->
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="TabText" Property="Foreground" Value="#D08770" />
                                            <Setter TargetName="TabText" Property="FontWeight" Value="SemiBold" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </StackPanel.Resources>

                <RadioButton Content="Усі" IsChecked="True" 
                             Style="{StaticResource FilterTabStyle}" 
                             Command="{Binding FilterItemsCommand}" CommandParameter="Всі" />

                <RadioButton Content="Хочу" 
                             Style="{StaticResource FilterTabStyle}" 
                             Command="{Binding FilterItemsCommand}" CommandParameter="Хочу" />  

                <RadioButton Content="Ін прогрес" 
                             Style="{StaticResource FilterTabStyle}" 
                             Command="{Binding FilterItemsCommand}" CommandParameter="Ін прогрес" />

                <RadioButton Content="Вже всьо"
                             Style="{StaticResource FilterTabStyle}" 
                             Command="{Binding FilterItemsCommand}" CommandParameter="Вже всьо" />

                <RadioButton Content="Вагаюсі" Margin="0"
                             Style="{StaticResource FilterTabStyle}" 
                             Command="{Binding FilterItemsCommand}" CommandParameter="Вагаюсі" />       
            </StackPanel>

            <!-- Input Bar (переміщено на Grid.Row="2") -->
            <Border Grid.Row="2" Background="#FAF6F0" CornerRadius="8" Padding="12" Margin="0,0,0,20" BorderBrush="#D4C9BC" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="ItemTitleTextBox" Grid.Column="0" Text="{Binding NewItemTitle, UpdateSourceTrigger=PropertyChanged}" FontSize="15" VerticalContentAlignment="Center" Padding="12,10" BorderThickness="1" BorderBrush="#E3DCD2" Background="White" Foreground="#2C221E" Margin="0,0,10,0" ToolTip="Введіть назву фільму, серіалу або гри" />

                    <Button Grid.Column="1" Command="{Binding AddItemCommand}" Content="Додати" FontSize="14" FontWeight="SemiBold" Foreground="White" Background="#D08770" BorderThickness="0" Padding="24,10" Cursor="Hand" IsDefault="True">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>

            <!-- Media Items List (переміщено на Grid.Row="3") -->
            <Border Grid.Row="3" Background="#FAF6F0" CornerRadius="8" Padding="16" BorderBrush="#D4C9BC" BorderThickness="1">
                <Grid>
                    <TextBlock Text="Поки що немає збережених записів. Додайте свій перший фільм чи гру вище!" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#A3968C" FontSize="14" FontStyle="Italic">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" BorderThickness="0">
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="140" Height="210" Margin="0,0,15,15" Background="#EFECE6" CornerRadius="8" ClipToBounds="True" BorderBrush="#D4CBC0" BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Image Grid.Row="0" 
                                                   Source="{Binding PosterUrl, IsAsync=True, TargetNullValue='pack://application:,,,/Assets/placeholder.jpg', FallbackValue='pack://application:,,,/Assets/placeholder.jpg'}" 
                                                   Stretch="UniformToFill" 
                                                   VerticalAlignment="Center"/>

                                            <Border Grid.Row="1" Background="#261E1A" Padding="8,10">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" Foreground="#F4EFEA" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Status}" Foreground="#A3968C" FontSize="11" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Status Bar (переміщено на Grid.Row="4") -->
            <StatusBar Grid.Row="4" Background="Transparent" Margin="0,12,0,0" Padding="0">
                <StatusBarItem Padding="0">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#78685E" />
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </Grid>
</Window>