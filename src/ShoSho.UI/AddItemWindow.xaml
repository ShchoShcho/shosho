<Window x:Class="ShoSho.UI.AddItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Додати новий запис" Width="520" Height="680" MinWidth="400" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="#F5EFE6" Foreground="#322824" FontFamily="Segoe UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,4,0,14"/>
            <Setter Property="Background" Value="#FDFBFC"/><Setter Property="BorderBrush" Value="#E0D6C8"/>
        </Style>
        <Style TargetType="ComboBox"><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,4,0,14"/></Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8C7A70"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Новий запис" FontFamily="Georgia" FontSize="26" Margin="0,0,0,20"/>

                <TextBlock Text="Назва *" Style="{StaticResource Label}"/>
                <TextBox x:Name="TitleInput" MaxLength="255" TextChanged="TitleInput_TextChanged"/>
                <TextBlock x:Name="TitleErrorText" Text="Поле «Назва» є обов'язковим." Foreground="#A33D32" FontSize="11" Margin="0,-10,0,10" Visibility="Collapsed"/>

                <TextBlock Text="Тип медіа" Style="{StaticResource Label}"/>
                <ComboBox x:Name="TypeInput"/>

                <TextBlock Text="Статус" Style="{StaticResource Label}"/>
                <ComboBox x:Name="StatusInput" SelectionChanged="StatusChanged"/>

                <TextBlock Text="Посилання або шлях до обкладинки" Style="{StaticResource Label}"/>
                <TextBox x:Name="PosterInput" MaxLength="1000"/>

                <TextBlock Text="Теги настрою (через кому або #)" Style="{StaticResource Label}"/>
                <TextBox x:Name="TagsInput"/>

                <TextBlock Text="Опис / нотатка" Style="{StaticResource Label}"/>
                <TextBox x:Name="NoteInput" MaxLength="2000" MinHeight="80" TextWrapping="Wrap" AcceptsReturn="True"/>

                <StackPanel x:Name="ReviewPanel" Visibility="Collapsed">
                    <TextBlock Text="Оцінка (1–5)" Style="{StaticResource Label}"/>
                    <TextBox x:Name="RatingInput" MaxLength="1"/>

                    <TextBlock Text="Відгук" Style="{StaticResource Label}"/>
                    <TextBox x:Name="ReviewInput" MaxLength="2000" MinHeight="80" TextWrapping="Wrap" AcceptsReturn="True"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock x:Name="ErrorText" Foreground="#A33D32" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Скасувати" IsCancel="True" Padding="22,10" Margin="0,0,10,0"/>
                <Button x:Name="SaveButton" Content="Зберегти" Click="SaveClicked" IsEnabled="False" Padding="22,10" Background="#C27A63" Foreground="White"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>