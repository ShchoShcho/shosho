<Window x:Class="ShoSho.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:ShoSho.UI.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:MainViewModel, IsDesignTimeCreatable=True}"
        Title="Шо-Шо" Height="700" Width="1000"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#F4EFEA"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#261E1A" Padding="20,30,20,20">
            <StackPanel>
                <TextBlock Text="Шо-Шо" FontSize="28" FontWeight="Normal" FontFamily="Georgia" Foreground="#EAE0D5" />
                <TextBlock Text="ОСОБИСТИЙ МЕДІААРХІВ" FontSize="10" Foreground="#8A7A71" Margin="0,4,0,30" />
                <TextBlock Text="КОЛЕКЦІЯ" FontSize="11" Foreground="#78685E" Margin="0,0,0,15" FontWeight="SemiBold" />
                <TextBlock Text="Усі враження" FontSize="14" Foreground="#F4EFEA" Margin="0,8"/>
                <TextBlock Text="Фільми" FontSize="14" Foreground="#A3968C" Margin="0,8"/>
                <TextBlock Text="Серіали" FontSize="14" Foreground="#A3968C" Margin="0,8"/>
                <TextBlock Text="Книги" FontSize="14" Foreground="#A3968C" Margin="0,8"/>
                <TextBlock Text="Ігри" FontSize="14" Foreground="#A3968C" Margin="0,8"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,25">
                <TextBlock Text="МОЯ КОЛЕКЦІЯ - 2026" FontSize="11" Foreground="#B89F89" FontWeight="SemiBold" Margin="0,0,0,5" />
                <TextBlock Text="Каталог вражень" FontSize="32" FontFamily="Georgia" Foreground="#2C221E" />
                <TextBlock Text="Фільми, книжки й світи, до яких хочеться повернутися." FontSize="14" Foreground="#78685E" Margin="0,6,0,0" />
            </StackPanel>

            <!-- Input Bar -->
            <Border Grid.Row="1" Background="#FAF6F0" CornerRadius="8" Padding="12" Margin="0,0,0,20" BorderBrush="#D4C9BC" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Натисніть кнопку, щоб додати новий фільм, серіал, книгу чи гру"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="#78685E" />

                    <Button Grid.Column="1"
                            Command="{Binding AddItemCommand}"
                            Content="+ Додати запис"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Background="#D08770"
                            BorderThickness="0"
                            Padding="20,10"
                            Cursor="Hand"
                            IsDefault="True">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>

            <!-- Media Items List -->
            <Border Grid.Row="2" Background="#FAF6F0" CornerRadius="8" Padding="16" BorderBrush="#D4C9BC" BorderThickness="1">
                <Grid>
                    <TextBlock Text="Поки що немає збережених записів. Додайте свій перший фільм чи гру вище!" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#A3968C" FontSize="14" FontStyle="Italic">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" BorderThickness="0">
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="140" Height="210" Margin="0,0,15,15" Background="#EFECE6" CornerRadius="8" ClipToBounds="True" BorderBrush="#D4CBC0" BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <!-- Верхня частина для картинки займає весь доступний простір -->
                                                <RowDefinition Height="*"/>
                                                <!-- Нижня частина підлаштовується під висоту тексту -->
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Обкладинка (Рядок 0) -->
                                            <Image Grid.Row="0" 
                                                   Source="{Binding PosterUrl, IsAsync=True, TargetNullValue='pack://application:,,,/Assets/placeholder.jpg', FallbackValue='pack://application:,,,/Assets/placeholder.jpg'}" 
                                                   Stretch="UniformToFill" 
                                                   VerticalAlignment="Center"/> 

                                            <!-- Блок з текстом (Рядок 1 - тепер чітко під картинкою) -->
                                            <Border Grid.Row="1" Background="#261E1A" Padding="8,10">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" Foreground="#F4EFEA" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Status}" Foreground="#A3968C" FontSize="11" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Status Bar -->
            <StatusBar Grid.Row="3" Background="Transparent" Margin="0,12,0,0" Padding="0">
                <StatusBarItem Padding="0">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#78685E" />
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </Grid>
</Window>