## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools.

# =========================
# Build results & Artifacts
# =========================
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
artifacts/
publish/

# =========================
# Visual Studio / Roslyn
# =========================
.vs/
*.user
*.userosscache
*.sln.docstates
*.suo
*.userprefs
*.ide/
*.swp

# Visual Studio temporary files
*.tmp
*.temp

# Roslyn analyzer cache
*.Generated.*

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains Rider / Resharper
.idea/
*.DotSettings.user
_ReSharper*/

# =========================
# .NET Core & Tools
# =========================
project.lock.json
project.fragment.lock.json
ScaffoldingReadMe.txt

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# MSBuild logs
*.binlog
[Bb]uild[Ll]og.*

# =========================
# Testing & Code Coverage
# =========================
[Tt]est[Rr]esult*/
TestResult.xml
nunit-*.xml
*.VisualState.xml
CodeCoverage/
*.coverage
*.coveragexml

# =========================
# Secrets & Environment
# =========================
.env
.env.*
!.env.example
appsettings.Development.json
appsettings.Local.json
*.pfx
*.key

# =========================
# OS Generated Files
# =========================
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Backup files
~$*
*~
*.bak